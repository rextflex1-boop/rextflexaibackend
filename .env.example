PORT=8080
PUBLIC_URL=https://rextflexaibackend.up.railway.app
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=*

# Groq secrets — keep ONLY on Railway/backend.
GROQ_API_KEY=
GROQ_MODEL_SILICON=openai/gpt-oss-20b
GROQ_MODEL_TITAN=openai/gpt-oss-120b
GROQ_MODEL_APEX=qwen/qwen3.8-27b
GROQ_WEB_MODEL=groq/compound-mini
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Neon / PostgreSQL
DATABASE_URL=

# Session security
SESSION_DAYS=30

# E2B — keep ONLY on Railway/backend
E2B_API_KEY=
E2B_MAX_ZIP_MB=8

# Optional Google OAuth for the mobile "Continue with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GROQ_DEVICE_MODEL=openai/gpt-oss-120b

GROQ_BUILD_MODEL=openai/gpt-oss-120b
GROQ_BUILD_MAX_TOKENS=14000
